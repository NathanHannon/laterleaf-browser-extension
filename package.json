{
  "name": "browser-extension",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run dev:chrome",
    "dev:chrome": "cross-env TARGET_BROWSER=chrome vite",
    "dev:firefox": "cross-env TARGET_BROWSER=firefox vite",
    "dev:safari": "cross-env TARGET_BROWSER=safari vite",
    "patch:firefox-manifest": "node scripts/patch-firefox-manifest.mjs",
    "build": "npm run build:chrome",
    "build:chrome": "cross-env TARGET_BROWSER=chrome tsc -b && cross-env TARGET_BROWSER=chrome vite build",
    "build:firefox": "cross-env TARGET_BROWSER=firefox tsc -b && cross-env TARGET_BROWSER=firefox vite build && npm run patch:firefox-manifest",
    "build:safari": "cross-env TARGET_BROWSER=safari tsc -b && cross-env TARGET_BROWSER=safari vite build",
    "build:all": "npm run build:chrome && npm run build:firefox && npm run build:safari",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@clerk/chrome-extension": "^2.8.6",
    "react": "^19.2.1",
    "react-dom": "^19.2.1"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.0.0-beta.33",
    "@eslint/js": "^9.39.1",
    "@mozilla/readability": "^0.6.0",
    "@types/chrome": "^0.1.31",
    "@types/dompurify": "^3.2.0",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "baseline-browser-mapping": "^2.9.19",
    "clsx": "^2.1.1",
    "cross-env": "^7.0.3",
    "dompurify": "^3.3.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "lucide-react": "^0.555.0",
    "sass": "^1.94.2",
    "tailwind-merge": "^3.4.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.3.7"
  }
}